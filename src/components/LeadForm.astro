<form class="form" name="contact" method="POST" action="/" data-netlify="true" netlify-honeypot="bot-field" data-ajax data-ok="Message sent. Keith will reply to the email you entered.">
  <input type="hidden" name="form_kind" value="contact" />
  <input type="hidden" name="submission_id" value="" />
  <input type="hidden" name="form-name" value="contact" />
  <p class="hp"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
  <div class="row">
    <div><label for="f-name">Name</label><input id="f-name" name="name" autocomplete="name" required /></div>
    <div><label for="f-email">Work email</label><input id="f-email" type="email" name="email" autocomplete="email" required /></div>
  </div>
  <div class="row">
    <div><label for="f-co">Company</label><input id="f-co" name="company" autocomplete="organization" required /></div>
    <div>
      <label for="f-size">Sales team size</label>
      <select id="f-size" name="team_size" required>
        <option value="">Choose one</option>
        <option>1–5 reps</option><option>6–20 reps</option><option>21–50 reps</option><option>51+ reps</option>
      </select>
    </div>
  </div>
  <div>
    <label for="f-svc">What do you need help with?</label>
    <select id="f-svc" name="service" required>
      <option value="">Choose one</option>
      <option>Process map and automation plan</option>
      <option>Building or rebuilding outbound / SDR</option>
      <option>Automation build</option>
      <option>Coaching for SDR leaders</option>
      <option>Not sure yet</option>
    </select>
  </div>
  <div>
    <label for="f-msg">What’s broken right now?</label>
    <textarea id="f-msg" name="message" placeholder="e.g. Our AI pilot stalled, and reps still research every account by hand." required></textarea>
  </div>
  <label class="check"><input type="checkbox" name="newsletter" value="yes" /> <span>Send me the KML newsletter. Unsubscribe anytime.</span></label>
  <div class="cta-row">
    <button class="btn btn-signal" type="submit">Send message</button>
    <p class="form-status" role="status" aria-live="polite"></p>
  </div>
</form>
