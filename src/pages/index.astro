---
import Base from '../layouts/Base.astro';
import ProcessExplorer from '../components/ProcessExplorer.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../config';
import { services } from '../data/services';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0,2);
---
<Base>
  <section class="immersive-hero" aria-labelledby="hero-title">
    <div class="wrap hero-copy">
      <p class="eyebrow">Go-to-market workflows for marketing and sales</p>
      <h1 id="hero-title">Your team should know<br class="desktop-break" /> what happens next.</h1>
      <p class="hero-description">KML maps how work moves between marketing and sales, then turns the decisions into a plan your team can build in the tools you already use.</p>
      <div class="cta-row"><a class="btn btn-signal" href={SITE.bookingUrl} target="_blank" rel="noopener">Book a 30-minute call <span aria-hidden="true">↗</span></a><a class="btn btn-ghost" href="#example">Explore a process <span aria-hidden="true">↓</span></a></div>
      <p class="scope-note">Implementation is scoped separately.</p>
    </div>
    <div class="signal-scene" data-signal>
      <div class="signal-art" aria-hidden="true"><div class="signal-grid"></div><div class="signal-atmosphere"></div><div class="signal-orbit"><div class="orbit-light"></div><div class="orbit-core"></div></div><div class="signal-beam beam-left"></div><div class="signal-beam beam-right"></div><div class="signal-center"><span class="center-dot"></span><span>A clear next step</span></div></div>
      <div class="scene-caption caption-left"><span class="eyebrow">The process</span><span>Decide who acts next.</span></div>
      <div class="scene-caption caption-right"><span class="eyebrow">The check</span><span>Confirm it happened.</span></div>
      <div class="scene-bottom"><a href="#example" class="text-link">See how the decisions connect <span aria-hidden="true">↓</span></a><button type="button" class="motion-control" aria-pressed="false" data-motion>Pause motion</button></div>
    </div>
  </section>
  <section class="band" id="problem"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">Start with the work your team has to chase</p><h2 class="h2">Where does the work stop?</h2></div></div>
    <div class="problem-grid">
      <article><span class="problem-marker" aria-hidden="true">01 /</span><h3>A buyer is waiting for a reply.</h3><p>If a request changes hands and nobody contacts the buyer, define who acts next and when a manager gets notified.</p><a class="text-link" href="#example">Explore the example <span aria-hidden="true">↗</span></a></article>
      <article><span class="problem-marker" aria-hidden="true">02 /</span><h3>Your team is still copying data between tools.</h3><p>If your team moves the same information between forms, spreadsheets, and your CRM, define what software can handle and what a person needs to check.</p><a class="text-link" href="/services#process-map">See the design work <span aria-hidden="true">↗</span></a></article>
      <article><span class="problem-marker" aria-hidden="true">03 /</span><h3>Sales can’t see what brought the buyer in.</h3><p>If campaign context disappears when a lead reaches sales, define which details move with the record and who acts on them.</p><a class="text-link" href="/services#process-map">Explore workflow design <span aria-hidden="true">↗</span></a></article>
    </div>
  </div></section>
  <ProcessExplorer />
  <section class="band" id="services"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">What you get</p><h2 class="h2">Start with one GTM workflow.</h2></div><p class="muted">Your builder gets the rules, required data, and checks for completion.</p></div>
    <div class="deliverable-layout"><div class="offer-summary"><span class="svc-tag">Start here</span><h3>GTM workflow map<br />+ build plan</h3><p>Your RevOps team can implement the design. KML implementation and support are scoped separately.</p><a class="btn btn-signal" href="/contact?service=process-map">Discuss a process map <span aria-hidden="true">↗</span></a></div><div class="deliverables">
      <details open><summary><span>01</span> Process map</summary><p>The steps from the first request to the completed action, with a person responsible for each step.</p></details>
      <details><summary><span>02</span> Build specification</summary><p>The data required and the rules for each decision, including where a person must review the work.</p></details>
      <details><summary><span>03</span> Failure handling</summary><p>What happens when data is missing or an action fails, who resolves it, and where the process resumes.</p></details>
      <details><summary><span>04</span> Acceptance checks</summary><p>The tests that show the process works, plus a walkthrough with the person building it.</p></details>
    </div></div>
    <div class="other-services"><p class="eyebrow">Other ways to work together</p><div>{services.slice(1).map(s=><a href={`/services#${s.slug}`}><span>{s.name}</span><span aria-hidden="true">↗</span></a>)}</div></div>
  </div></section>
  <section class="band" id="about"><div class="wrap about-grid"><div><p class="eyebrow">Meet Keith</p><h2 class="h2">Designed around<br />the work your team does.</h2></div><div><p class="about-copy">I’m Keith. My background is in SDR leadership, and I build tools for the people doing the work. KML brings that practical approach to go-to-market workflows across marketing and sales.</p><p class="muted">The work starts with how your team works today, from a campaign response to the next sales conversation. The design makes the next action explicit, including what happens when something goes wrong.</p><a class="text-link" href="/apps">See Tempo, a tool I built for reps <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="band" id="blog"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">From the blog</p><h2 class="h2">How I think about the work.</h2></div><a href="/blog" class="text-link">All posts <span aria-hidden="true">↗</span></a></div><div class="posts">{posts.map(p=><a class="post-row" href={`/blog/${p.id}`}><span class="muted">{p.data.readMinutes ?? 5} min read</span><div><h3>{p.data.title}</h3><p>{p.data.description}</p></div><span aria-hidden="true">↗</span></a>)}</div></div></section>
  <CtaBand />
  <script>
    const scene = document.querySelector<HTMLElement>('[data-signal]');
    const motion = document.querySelector<HTMLButtonElement>('[data-motion]');
    if(scene && motion) {
      const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
      let paused = preference.matches;
      const sync = () => { scene.classList.toggle('motion-paused',paused); motion.setAttribute('aria-pressed',String(paused)); motion.textContent = paused ? 'Resume motion' : 'Pause motion'; };
      sync();
      motion.addEventListener('click',()=>{paused=!paused;sync();});
      preference.addEventListener('change',e=>{paused=e.matches;sync();});
      scene.addEventListener('pointermove',e=>{
        if(paused || preference.matches || e.pointerType !== 'mouse') return;
        const r=scene.getBoundingClientRect();
        scene.style.setProperty('--pointer-x',`${(e.clientX-r.left-r.width/2)*0.025}px`);
        scene.style.setProperty('--pointer-y',`${(e.clientY-r.top-r.height/2)*0.035}px`);
      });
      scene.addEventListener('pointerleave',()=>{scene.style.setProperty('--pointer-x','0px');scene.style.setProperty('--pointer-y','0px');});
      const observer = new IntersectionObserver(entries=>{scene.classList.toggle('offscreen',!entries[0].isIntersecting);});
      observer.observe(scene);
    }
  </script>
</Base>
