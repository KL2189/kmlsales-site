---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="page-hero grain" style="min-height:60vh">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap load-in">
      <h1 class="display">This page isn’t in the process map.</h1>
      <p class="lede">The link may be old or mistyped. Head home, or go straight to what you came for.</p>
      <div class="cta-row" style="margin-top:30px"><a class="btn btn-signal" href="/">Go home</a><a class="btn btn-ghost" href="/blog">Read the blog</a></div>
    </div>
  </section>
</Base>
