---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services';
import { SITE } from '../config';
const faqs = [
  { q: 'How is this different from buying another automation tool?', a: 'An AI tool runs whatever steps you give it. The map decides which steps it should run, so the tool actually gets used.' },
  { q: 'Do we need RevOps to build this?', a: 'No. Keith builds it in your tools, and the map and build spec are also available on their own if your team wants to build it.' },
  { q: 'Who is this for?', a: 'Series A and B SaaS teams hiring their first SDRs or switching on an AI SDR. If you want someone to send cold email for you, an agency is a better fit.' },
  { q: 'Do I need to know what I want before we talk?', a: 'No. The first call finds the one workflow worth fixing first.' },
  { q: 'How is pricing set?', a: 'Each engagement is scoped and priced after the first call, before any work starts. Ongoing support after launch is priced on its own.' },
];
---
<Base title="Services" description="Outbound and AI sales workflows for Series A and B SaaS. Keith maps how your team sells and builds it in your CRM and sequencing tools.">
  <section class="page-hero grain band-black">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap load-in">
      <h1 class="display">Start with one workflow your team runs every day.</h1>
      <p class="lede">Keith maps how it works today and builds the new version in the tools you already pay for. You don’t need a RevOps hire to get it live.</p>
      <div class="cta-row" style="margin-top:36px">
        <a class="btn btn-signal" href={SITE.bookingUrl} target="_blank" rel="noopener" data-cta="services-hero">Book a 30-minute call</a>
      </div>
    </div>
  </section>

  {services.map((s, i) => (
    <section class={`band ${['band-white', 'band-graphite', 'band-light', 'band-black'][i % 4]}`} id={s.slug}>
      {s.slug === 'sales-coaching' && <span id="sdr-coaching" aria-hidden="true"></span>}
      <div class="wrap svc svc-page">
        <div>
          <p class="svc-tag">{s.tag}</p>
          <h2 class="h2">{s.name}</h2>
          <p class="lede" style="margin-top:20px">{s.problem}</p>
          <p class="for">{s.how}</p>
        </div>
        <div>
          <h3 class="list-title">What you get</h3>
          <ul>{s.outcomes.map((o) => <li>{o}</li>)}</ul>
          <a class="btn btn-ghost btn-sm" style="margin-top:32px" href={`/contact?service=${s.slug}`}>Ask about this</a>
        </div>
      </div>
    </section>
  ))}

  <section class="band band-white">
    <div class="wrap" style="max-width:900px">
      <h2 class="h2 section-title">Common questions</h2>
      <div class="faq">
        {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
