---
import '../styles/global.css';
import '../styles/immersive.css';
import '../styles/motion.css';
import { SITE } from '../config';
interface Props { title?: string; description?: string; path?: string; type?: string; jsonld?: object; }
const { title, description = SITE.description, type = 'website', jsonld } = Astro.props;
const fullTitle = title ? `${title} | KML Sales` : 'KML Sales | Outbound systems for Series A and B SaaS';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/services', label: 'Services' },
  { href: '/apps', label: 'Apps' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];
const org = {
  '@context': 'https://schema.org', '@type': 'ProfessionalService', name: 'KML Sales', url: 'https://kmlsales.com',
  email: SITE.email, description: SITE.description, logo: 'https://kmlsales.com/brand/kml-stacked-white.svg',
  founder: { '@type': 'Person', name: 'Keith' },
  areaServed: 'Worldwide',
  serviceType: ['Sales workflow mapping and build', 'AI sales workflow build', 'Outbound system build', 'Sales leadership coaching'],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#000000" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="KML Sales Blog" href="/rss.xml" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://kmlsales.com/og.png" />
  <meta property="og:site_name" content="KML Sales" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://kmlsales.com/og.png" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonld ?? org)} />
  <script is:inline>if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&'IntersectionObserver' in window)document.documentElement.classList.add('motion');</script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header" id="top">
    <div class="wrap nav">
      <a class="brand" href="/" aria-label="KML Sales home"><img src="/brand/kml-horizontal-white.svg" alt="KML Sales Fundamentals" width="181" height="46" /></a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="nav-links" aria-label="Open menu">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M3 6h14M3 10h14M3 14h14"/></svg>
      </button>
      <ul class="nav-links" id="nav-links">
        {nav.map((n) => <li><a href={n.href} aria-current={current.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
        <li><a class="btn btn-signal btn-sm" href={SITE.bookingUrl} target="_blank" rel="noopener" data-cta="header">Book a call</a></li>
      </ul>
    </div>
  </header>
  <main id="main"><slot /></main>
  <hr class="rule-signal" />
  <footer class="site-footer" style="margin-top:0">
    <div class="wrap">
      <div class="foot-grid">
        <div>
          <img src="/brand/kml-stacked-white.svg" alt="KML Sales Fundamentals" width="210" height="101" />
          <p class="muted" style="max-width:34ch;margin-top:16px">Outbound systems for Series A and B SaaS.</p>
        </div>
        <div>
          <h4>Site</h4>
          <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
        </div>
        <div>
          <h4>Newsletter</h4>
          <p class="muted" style="margin:0 0 14px;font-size:.95rem">Practical notes on outbound and AI sales workflows. Unsubscribe anytime.</p>
          <form class="foot-form" name="newsletter" method="POST" action="/" data-netlify="true" netlify-honeypot="bot-field" data-ajax data-ok="You’re subscribed.">
            <input type="hidden" name="form_kind" value="newsletter" />
  <input type="hidden" name="submission_id" value="" />
  <input type="hidden" name="form-name" value="newsletter" /><input type="hidden" name="source" value="footer" />
            <p style="position:absolute;left:-9999px"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
            <label for="foot-email" style="position:absolute;left:-9999px">Email</label>
            <input id="foot-email" type="email" name="email" placeholder="you@company.com" autocomplete="email" required />
            <button class="btn btn-signal btn-sm" type="submit">Subscribe</button>
            <p class="form-status" role="status" aria-live="polite"></p>
          </form>
        </div>
        <div>
          <h4>Get in touch</h4>
          <ul>
            <li><a href={SITE.bookingUrl} target="_blank" rel="noopener">Book a call</a></li>
            <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            <li><a href="/rss.xml">Blog RSS</a></li>
          </ul>
        </div>
      </div>
      <div class="foot-base"><span>© {new Date().getFullYear()} KML Sales</span><a href="#top" style="text-decoration:none">Back to top</a></div>
    </div>
  </footer>
  <script is:inline>
    (function () {
      var h = document.querySelector('.site-header');
      var onS = function () { h && h.classList.toggle('scrolled', window.scrollY > 8); };
      onS(); window.addEventListener('scroll', onS, { passive: true });
      var t = document.querySelector('.menu-toggle'), l = document.getElementById('nav-links');
      if (t && l) t.addEventListener('click', function () {
        var o = l.classList.toggle('open'); t.setAttribute('aria-expanded', String(o)); t.setAttribute('aria-label', o ? 'Close menu' : 'Open menu');
      });
      document.addEventListener('keydown', function(e) { if(e.key === 'Escape' && l && l.classList.contains('open')) { l.classList.remove('open'); t.setAttribute('aria-expanded','false'); t.setAttribute('aria-label','Open menu'); t.focus(); } });
      document.querySelectorAll('form[data-ajax]').forEach(function (f) {
        f.addEventListener('submit', function (e) {
          e.preventDefault();
          var s = f.querySelector('.form-status'), b = f.querySelector('button[type=submit]');
          var id = f.querySelector('input[name=submission_id]');
          if (id && !id.value) id.value = crypto.randomUUID();
          var label = b.textContent;
          b.disabled = true; b.textContent = 'Sending…'; s.className = 'form-status'; s.textContent = '';
          fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(new FormData(f)).toString() })
            .then(function (r) { if (!r.ok) throw new Error('x'); })
            .then(function () { s.className = 'form-status ok'; s.textContent = f.dataset.ok || 'Sent.'; f.reset(); })
            .catch(function () { s.className = 'form-status err'; s.innerHTML = 'That didn’t go through. Email <a href="mailto:keith@kmlsales.com">keith@kmlsales.com</a> directly.'; })
            .finally(function () { b.disabled = false; b.textContent = label; });
        });
      });
    })();
  </script>
  <script is:inline>
    (function () {
      if (!document.documentElement.classList.contains('motion')) return;
      // Hero headline: split into words that rise in one after another
      var h1 = document.querySelector('.hero-copy h1');
      if (h1) {
        h1.setAttribute('aria-label', h1.textContent.replace(/\s+/g, ' ').trim());
        var i = 0;
        Array.prototype.slice.call(h1.childNodes).forEach(function (n) {
          if (n.nodeType !== 3) return;
          var frag = document.createDocumentFragment();
          n.textContent.split(/(\s+)/).forEach(function (w) {
            if (!w) return;
            if (/^\s+$/.test(w)) { frag.appendChild(document.createTextNode(w)); return; }
            var s = document.createElement('span'); s.className = 'word'; s.setAttribute('aria-hidden', 'true');
            s.style.setProperty('--i', i++); s.textContent = w; frag.appendChild(s);
          });
          n.parentNode.replaceChild(frag, n);
        });
      }
      // Scroll reveals
      var groups = ['.section-heading', '.problem-grid article', '.explorer', '.offer-summary', '.deliverables details', '.other-services',
        '.about-grid > div', '.post-row', '.cta-band', '.svc', '.page-hero .wrap > *', '.faq details', '.app-feature', '.post-body > *'];
      document.querySelectorAll(groups.join(',')).forEach(function (el) {
        if (el.closest('.immersive-hero')) return;
        var sibs = Array.prototype.filter.call(el.parentNode.children, function (c) { return c.tagName === el.tagName; });
        el.style.setProperty('--d', Math.min(sibs.indexOf(el), 5));
        el.setAttribute('data-reveal', '');
      });
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
      document.querySelectorAll('[data-reveal], .band').forEach(function (el) { io.observe(el); });
      // Cursor light on problem cards
      document.querySelectorAll('.problem-grid article').forEach(function (a) {
        a.addEventListener('pointermove', function (e) {
          var r = a.getBoundingClientRect();
          a.style.setProperty('--mx', (e.clientX - r.left) + 'px'); a.style.setProperty('--my', (e.clientY - r.top) + 'px');
        });
      });
    })();
  </script>
</body>
</html>
